# 大模型服务商：dashscope（阿里百炼）/ openai（任意兼容接口）/ ollama（本地）/ none（不调用模型，只返回检索原文）
HDNZ_PROVIDER=dashscope

# 方舟/百炼兼容接口地址（dashscope 时可留空，默认用官方 compatible-mode）
HDNZ_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 你的 API Key
HDNZ_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名：qwen-plus（性价比）/ qwen-max（最像原站效果）/ qwen-turbo（便宜）
HDNZ_MODEL=qwen-plus
